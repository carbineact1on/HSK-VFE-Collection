	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_20x102mmNATO_AP</defName>
		<label>make 20x102mm NATO (AP) cartridge x60</label>
		<description>Craft 60 20x102mm NATO (AP) cartridges.</description>
		<jobString>Making 20x102mm NATO (AP) cartridges.</jobString>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.8</workSkillLearnFactor>
		<skillRequirements><Crafting>10</Crafting></skillRequirements>
		<researchPrerequisite>Range_C2</researchPrerequisite>
		<ingredients>
			<li><filter><categories><li>SLDBar</li><li>USLDBar</li></categories></filter><count>40</count></li>
			<li><filter><categories><li>USLDHBar</li></categories></filter><count>15</count></li>
			<li><filter><thingDefs><li>Powder</li></thingDefs></filter><count>8</count></li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs><li>Powder</li></thingDefs>
			<categories><li>SLDBar</li><li>USLDBar</li><li>USLDHBar</li></categories>
		</fixedIngredientFilter>
		<products><Ammo_20x102mmNATO_AP>60</Ammo_20x102mmNATO_AP></products>
	</RecipeDef>
