    <Operation Class="PatchOperationReplace">
        <xpath>Defs/FactionDef[defName="Insect"]/raidCommonalityFromPointsCurve</xpath>
        <value>
            <raidCommonalityFromPointsCurve>
                <points>
                    <li>(0, 0)</li>
                    <li>(799, 0)</li>
                    <li>(800, 0.001)</li>
                    <li>(1400, 1.8)</li>
                    <li>(2800, 2.2)</li>
                    <li>(4000, 2.6)</li>
                </points>
            </raidCommonalityFromPointsCurve>
        </value>
    </Operation>

</Patch>
