<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>AmmoLaserChargePack</defName>
		<label>laser charge pack</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberCharge</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="LaserChargePackBase" ParentName="SpacerSmallAmmoBase" Abstract="True">
		<description>A universal charge pack for various laser weapons.</description>
		<statBases>
			<Mass>0.008</Mass>
			<Bulk>0.01</Bulk>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoLaserChargePack</li>
		</thingCategories>
		<stackLimit>5000</stackLimit>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="LaserChargePackBase">
		<defName>Ammo_LaserChargePack</defName>
		<label>laser charge pack</label>
		<graphicData>
			<texPath>Things/Ammo/LaserPack</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<ammoClass>Laser</ammoClass>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_LaserChargePack</defName>
		<label>make laser charge pack x40</label>
		<description>Craft 40 laser charge packs.</description>
		<jobString>Making laser charge packs.</jobString>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.8</workSkillLearnFactor>
		<skillRequirements>
			<Crafting>10</Crafting>
		</skillRequirements>
		<researchPrerequisite>ChargedShot</researchPrerequisite>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>USLDBar</li>
					</categories>
				</filter>
				<count>15</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Hexcell</li>
					</thingDefs>
				</filter>
				<count>3</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Microchips</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Hexcell</li>
				<li>Microchips</li>
			</thingDefs>
			<categories>
				<li>USLDBar</li>
			</categories>
		</fixedIngredientFilter>
		<products>
			<Ammo_LaserChargePack>40</Ammo_LaserChargePack>
		</products>
	</RecipeDef>

</Defs>