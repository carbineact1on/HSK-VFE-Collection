			<thingDefs><li>Powder</li></thingDefs>
			<categories><li>SLDBar</li><li>USLDBar</li><li>USLDHBar</li></categories>
		</fixedIngredientFilter>
		<products><Ammo_25x137mmNATO_AP>60</Ammo_25x137mmNATO_AP></products>
