		<ingredients>
			<li><filter><categories><li>SLDBar</li><li>USLDBar</li></categories></filter><count>7</count></li>
			<li><filter><categories><li>HeavyBar</li></categories></filter><count>6</count></li>
			<li><filter><thingDefs><li>Powder</li></thingDefs></filter><count>2</count></li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs><li>Powder</li></thingDefs>
			<categories><li>SLDBar</li><li>USLDBar</li><li>HeavyBar</li></categories>
		</fixedIngredientFilter>
		<products><Ammo_Slugthrower_Slug>40</Ammo_Slugthrower_Slug></products>
	</RecipeDef>
	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_Slugthrower_Beanbag</defName>
		<label>make slugthrower (Beanbag) shell x40</label>
		<description>Craft 40 slugthrower (Beanbag) shells.</description>
		<jobString>Making slugthrower (Beanbag) shells.</jobString>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.8</workSkillLearnFactor>
		<skillRequirements><Crafting>3</Crafting></skillRequirements>
		<ingredients>
			<li><filter><thingDefs><li>Plastic</li></thingDefs></filter><count>4</count></li>
			<li><filter><categories><li>BTextiles</li></categories></filter><count>3</count></li>
			<li><filter><thingDefs><li>Powder</li></thingDefs></filter><count>2</count></li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs><li>Plastic</li><li>Powder</li></thingDefs>
			<categories><li>BTextiles</li></categories>
		</fixedIngredientFilter>
		<products><Ammo_Slugthrower_Beanbag>40</Ammo_Slugthrower_Beanbag></products>
	</RecipeDef>
