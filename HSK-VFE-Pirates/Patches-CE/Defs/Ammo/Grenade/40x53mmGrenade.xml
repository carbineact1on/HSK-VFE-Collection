		<jobString>Making 40x53mm grenade (HE) grenades.</jobString>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.8</workSkillLearnFactor>
		<skillRequirements><Crafting>9</Crafting></skillRequirements>
		<researchPrerequisite>Range_C2</researchPrerequisite>
		<ingredients>
			<li><filter><categories><li>SLDBar</li><li>USLDBar</li></categories></filter><count>40</count></li>
			<li><filter><thingDefs><li>Powder</li></thingDefs></filter><count>10</count></li>
