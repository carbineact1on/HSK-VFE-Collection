				<li>FSX</li>
			</thingDefs>
			<categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
				
			</categories>
		</fixedIngredientFilter>
		<products><Ammo_40x53mmGrenade_HE>20</Ammo_40x53mmGrenade_HE></products>
	</RecipeDef>
