<?xml version="1.0" encoding="utf-8"?>
<!-- Make all warcasket weapon boxes loot-only (uncraftable) and remove -->
<Patch>
    <!-- Strip designationCategory from abstract parent (cascades to all 12 weapon boxes) -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[@Name="VFEP_WarcasketWeaponBoxBase"]/designationCategory</xpath>
    </Operation>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef/researchPrerequisites/li[text()="VFEP_WarcasketWeaponry"]</xpath>
    </Operation>
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef/researchPrerequisites/li[text()="VFEP_SpacerWarcasketWeaponry"]</xpath>
    </Operation>

    <!-- Remove orphaned research projects -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ResearchProjectDef[defName="VFEP_WarcasketWeaponry" or defName="VFEP_SpacerWarcasketWeaponry"]</xpath>
    </Operation>
</Patch>
