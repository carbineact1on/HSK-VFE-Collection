<?xml version="1.0" encoding="utf-8" ?>
<!-- HSK patch: hide 21 VFE Mechanoids player-buildable buildings from the architect menu
     where they duplicate HSK's existing content. Enemy raids + quest generation still
     use them because ThingDefs remain intact; only designationCategory is removed.

     Preserved: Autoharvester, Autosower, Textile recycler, Mechanite LF reinforcer,
     Blight auto repeller, AutoMedicBase, AutobroadcasterBase, Autostrider, CombatBase,
     PyroBase, RaiderBase, RiotBase, TurretBase, Factory hopper, Versatile assembler,
     Supercomputer, Indoctrination Pod, all 4 auto-turrets, Long range missile launcher.

     NOTE: VFE Mechanoids defines designationCategory directly on the child defs
     (not inherited), so PatchOperationRemove works cleanly (unlike Deserters/Pirates
     turrets which inherited from parents). -->
<Patch>

  <!-- ELECTRONICS FABRICATION (3) — HSK has Electric Smelter + Fabrication Bench -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_ElectronicsFabricationFactory_SteelExtractor"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_ElectronicsFabricationFactory_ComponentAssembler"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_ElectronicsFabricationFactory_AdvancedAssembler"]/designationCategory</xpath>
  </Operation>

  <!-- MASONRY + METALLICS (3) — HSK has Deep Drill, Stonecutter, Smithy -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_MasonryAndMetallicsFactory_AutomaticDrill"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_MasonryAndMetallicsFactory_MasonrySaw"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_MasonryAndMetallicsFactory_PlasteelForge"]/designationCategory</xpath>
  </Operation>

  <!-- MUNITIONS + ARMAMENT (3) — HSK has TableMachining + Biofuel Refinery + weapon benches -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_MunitionsAndArmamentFactory_ArtilleryFoundry"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_MunitionsAndArmamentFactory_ChemfuelClarifier"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_MunitionsAndArmamentFactory_MechanizedWeaponsmith"]/designationCategory</xpath>
  </Operation>

  <!-- MEDICINAL (3) — HSK has Drug Lab + Medicine Bench -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_MedicinalCompoundingFactory_DrugPowderizer"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_MedicinalCompoundingFactory_MedicineGranulator"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_MedicinalCompoundingFactory_NeutroamineInfuser"]/designationCategory</xpath>
  </Operation>

  <!-- PROVISIONS (2) — HSK has stoves + butcher table -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_ProvisionsPackagingFactory_ConveyorOven"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_ProvisionsPackagingFactory_MeatGrinder"]/designationCategory</xpath>
  </Operation>

  <!-- WEARABLES + TEXTILES (2) — HSK has Tailoring Bench -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_WearablesAndTextileFactory_AutoLoom"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_WearablesAndTextileFactory_SynthreadSynthesizer"]/designationCategory</xpath>
  </Operation>

  <!-- MECH STATIONS (6) — HSK has haplo.miscellaneous.robots.hsk + own turret roster -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFE_Mechanoids_AutocleanerBase"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFE_Mechanoids_AutohaulerBase"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFE_Mechanoids_AutominerBase"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="VFE_Mechanoids_AutobuilderBase"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFE_Mechanoids_TurretBase"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFE_Mechanoids_AutobroadcasterBase"]/designationCategory</xpath>
  </Operation>

  <!-- MISSILE LAUNCHER (1) — HSK has its own artillery / rocket systems -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFE_LongRangeMissileLauncher"]/designationCategory</xpath>
  </Operation>

  <!-- PRODUCTION INFRASTRUCTURE (3) — HSK has own production chains + tailoring -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_HeavyHopper"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_VersatileAssembler"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_WearablesAndTextileFactory_TextileRecycler"]/designationCategory</xpath>
  </Operation>

  <!-- UTILITY (3) — HSK has cranes, freezers, lamps -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEM_Autocrane"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFE_MechanoidLiquidFreezer"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFE_MechanoidConstructionLamp"]/designationCategory</xpath>
  </Operation>

</Patch>
