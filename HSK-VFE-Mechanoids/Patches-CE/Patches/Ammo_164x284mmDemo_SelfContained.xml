<?xml version="1.0" encoding="utf-8"?>
<!--
    Self-contained 164x284mm Demolition Shell ammo for the VFE-Mechanoids
    "advanced thump cannon" (mech weapon).

    Our Weapons_Mech.xml CE patch binds that gun to AmmoSet_164x284mmDemo /
    Bullet_164x284mmDemo, and CombinationDefs.xml lets the Versatile Assembler
    produce Ammo_164x284mmDemo. But those defs originally only existed in the
    Pacas Patches Compilation's CONDITIONAL Mods/2_AlphaMechs/ folder, which
    loads only when the Alpha Mechs mod is active. Without Alpha Mechs the defs
    never load and every reference dangles:
      "Could not resolve cross-reference: No CombatExtended.AmmoSetDef named
       AmmoSet_164x284mmDemo ..." / "...No ThingDef named Bullet_164x284mmDemo..."
    (Load-log report, 2026-06.)

    Defs copied from Pacas Mods/2_AlphaMechs/1.5/Defs/Ammo/Advanced/
    164x284mmDemoShell.xml, unchanged. ThermobaricFuel ammoClass and the
    AmmoAdvanced category both survive HSK Core_SK (verified - NOT in its
    AmmoCategoryDef removal list, unlike RailgunSabot/Plasma/NanobotsMT).

    Guarded with PatchOperationTest + Invert (the .408 CheyTac self-contained
    ammo pattern): if AmmoSet_164x284mmDemo already exists in the combined XML
    (player runs Alpha Mechs + Pacas), the sequence aborts and we add nothing,
    avoiding duplicate defs. success=Always suppresses the "failed" report on
    that intentional abort.
-->
<Patch>
    <Operation Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
            <li Class="PatchOperationTest">
                <xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_164x284mmDemo"]</xpath>
                <success>Invert</success>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>/Defs</xpath>
                <value>

                    <ThingCategoryDef>
                        <defName>Ammo164x284mmDemoCell</defName>
                        <label>164x284mm Demolition Shell</label>
                        <parent>AmmoAdvanced</parent>
                        <iconPath>UI/Icons/ThingCategories/CaliberFuelLarge</iconPath>
                    </ThingCategoryDef>

                    <CombatExtended.AmmoSetDef>
                        <defName>AmmoSet_164x284mmDemo</defName>
                        <label>164x284mm Demolition Shell</label>
                        <ammoTypes>
                            <Ammo_164x284mmDemo>Bullet_164x284mmDemo</Ammo_164x284mmDemo>
                        </ammoTypes>
                    </CombatExtended.AmmoSetDef>

                    <ThingDef Class="CombatExtended.AmmoDef" Name="164x284mmDemoBase" ParentName="SpacerSmallAmmoBase" Abstract="True">
                        <description>A high-caliber, low-velocity mechanoid demolition shell designed to destroy fortifications and structures.</description>
                        <statBases>
                            <Mass>0.256</Mass>
                            <Bulk>3.87</Bulk>
                        </statBases>
                        <thingCategories>
                            <li>Ammo164x284mmDemoCell</li>
                        </thingCategories>
                        <stackLimit>25</stackLimit>
                        <tradeTags>
                            <li>CE_AutoEnableTrade_Sellable</li>
                        </tradeTags>
                    </ThingDef>

                    <ThingDef Class="CombatExtended.AmmoDef" ParentName="164x284mmDemoBase">
                        <defName>Ammo_164x284mmDemo</defName>
                        <label>164x284mm Demolition Shell</label>
                        <graphicData>
                            <texPath>Things/Ammo/FuelCell/Large</texPath>
                            <graphicClass>Graphic_StackCount</graphicClass>
                        </graphicData>
                        <statBases>
                            <MarketValue>10.97</MarketValue>
                        </statBases>
                        <ammoClass>ThermobaricFuel</ammoClass>
                        <detonateProjectile>Bullet_164x284mmDemo</detonateProjectile>
                        <comps>
                            <li Class="CompProperties_Explosive">
                                <explosiveRadius>1</explosiveRadius>
                                <damageAmountBase>18</damageAmountBase>
                                <explosiveDamageType>Thermobaric</explosiveDamageType>
                                <explosiveExpandPerStackcount>0.10</explosiveExpandPerStackcount>
                                <startWickHitPointsPercent>0.33</startWickHitPointsPercent>
                                <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
                                <explodeOnKilled>True</explodeOnKilled>
                                <wickTicks>60~300</wickTicks>
                            </li>
                        </comps>
                    </ThingDef>

                    <ThingDef ParentName="BaseBullet">
                        <defName>Bullet_164x284mmDemo</defName>
                        <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
                        <label>164x284mm demolition shell</label>
                        <graphicData>
                            <texPath>Things/Projectile/LauncherShot</texPath>
                            <graphicClass>Graphic_Single</graphicClass>
                            <shaderType>TransparentPostLight</shaderType>
                        </graphicData>
                        <projectile Class="CombatExtended.ProjectilePropertiesCE">
                            <damageDef>Thump</damageDef>
                            <damageAmountBase>20</damageAmountBase>
                            <armorPenetrationSharp>0</armorPenetrationSharp>
                            <armorPenetrationBlunt>0</armorPenetrationBlunt>
                            <speed>48</speed>
                            <flyOverhead>false</flyOverhead>
                            <explosionRadius>2</explosionRadius>
                            <soundExplode>ThumpCannon_Impact</soundExplode>
                            <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
                            <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
                            <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
                        </projectile>
                        <comps>
                            <li Class="CombatExtended.CompProperties_Fragments">
                                <fragments>
                                    <Bullet_164x284mmDemo_ASA>2</Bullet_164x284mmDemo_ASA>
                                    <Bullet_164x284mmDemo_ASB>2</Bullet_164x284mmDemo_ASB>
                                </fragments>
                                <fragSpeedFactor>0.01</fragSpeedFactor>
                            </li>
                        </comps>
                    </ThingDef>

                    <ThingDef ParentName="BaseBullet">
                        <defName>Bullet_164x284mmDemo_ASA</defName>
                        <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
                        <label>164x284mm demolition shell</label>
                        <graphicData>
                            <texPath>Things/Projectile/LauncherShot</texPath>
                            <graphicClass>Graphic_Single</graphicClass>
                            <shaderType>TransparentPostLight</shaderType>
                        </graphicData>
                        <projectile Class="CombatExtended.ProjectilePropertiesCE">
                            <damageDef>Thump</damageDef>
                            <damageAmountBase>10</damageAmountBase>
                            <armorPenetrationSharp>0</armorPenetrationSharp>
                            <armorPenetrationBlunt>0</armorPenetrationBlunt>
                            <speed>1</speed>
                            <gravityFactor>50</gravityFactor>
                            <flyOverhead>false</flyOverhead>
                            <explosionRadius>2</explosionRadius>
                            <soundExplode>ThumpCannon_Impact</soundExplode>
                            <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
                            <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
                            <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
                        </projectile>
                        <comps>
                            <li Class="CombatExtended.CompProperties_Fragments">
                                <fragments>
                                    <Bullet_164x284mmDemo_ASB>2</Bullet_164x284mmDemo_ASB>
                                </fragments>
                                <fragSpeedFactor>0.01</fragSpeedFactor>
                            </li>
                        </comps>
                    </ThingDef>

                    <ThingDef ParentName="BaseBullet">
                        <defName>Bullet_164x284mmDemo_ASB</defName>
                        <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
                        <label>164x284mm demolition shell</label>
                        <graphicData>
                            <texPath>Things/Projectile/LauncherShot</texPath>
                            <graphicClass>Graphic_Single</graphicClass>
                            <shaderType>TransparentPostLight</shaderType>
                        </graphicData>
                        <projectile Class="CombatExtended.ProjectilePropertiesCE">
                            <damageDef>Thump</damageDef>
                            <damageAmountBase>10</damageAmountBase>
                            <armorPenetrationSharp>0</armorPenetrationSharp>
                            <armorPenetrationBlunt>0</armorPenetrationBlunt>
                            <speed>1</speed>
                            <gravityFactor>50</gravityFactor>
                            <flyOverhead>false</flyOverhead>
                            <explosionRadius>2</explosionRadius>
                            <soundExplode>ThumpCannon_Impact</soundExplode>
                            <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
                            <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
                            <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
                            <explosionDelay>15</explosionDelay>
                        </projectile>
                    </ThingDef>

                </value>
            </li>
        </operations>
    </Operation>
</Patch>
